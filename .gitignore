# Common files and directories to ignore

# Environment variables and secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*

# Operating system files
.DS_Store
Thumbs.db

# Editor settings
.vscode/
.idea/

# Python cache
__pycache__/
*.py[cod]

# Virtual environments
venv/
.venv/

# Temporary files
*.tmp
*.temp
